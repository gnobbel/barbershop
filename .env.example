# Postgres connection string (Neon: use the "pooled" connection string)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Public address of the site, used in email links (no trailing slash)
SITE_URL=https://your-site.vercel.app

# Password for the /admin area
ADMIN_PASSWORD=choose-a-long-password

# Random secret used to sign the admin session and calendar feed link.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Shared secret the reminder job uses to call /api/cron/reminders
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Resend (https://resend.com). Leave RESEND_API_KEY empty locally to print emails to the console.
RESEND_API_KEY=
# Sender, e.g. "The Chair <bookings@yourdomain.com>" (domain must be verified in Resend)
EMAIL_FROM=The Chair <onboarding@resend.dev>
# Where new-booking / cancellation alerts are sent (your own email)
ADMIN_EMAIL=you@example.com
